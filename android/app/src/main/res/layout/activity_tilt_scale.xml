<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.14"
                android:text="@string/tilt_title"
                android:textAllCaps="true"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="@string/tilt_open_press"
                android:textColor="@color/muted"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- odczyt -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="30dp"
            android:paddingBottom="26dp">

            <TextView
                android:id="@+id/value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:text="@string/tilt_zero_deg"
                android:textColor="@color/ink"
                android:textSize="66sp" />

            <TextView
                android:id="@+id/unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:text="@string/tilt_unit_deg"
                android:textColor="@color/muted"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:text="@string/tilt_detail_raw"
                android:textColor="@color/accent"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/stability"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.05"
                android:text="@string/tilt_waiting"
                android:textColor="@color/muted"
                android:textSize="12.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_chip"
            android:lineSpacingMultiplier="1.4"
            android:padding="14dp"
            android:text="@string/tilt_status_start"
            android:textColor="@color/ink"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/zero"
            style="@style/Btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/tilt_btn_zero" />

        <!-- kalibracja: raz w życiu, więc na dole i po cichu -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:letterSpacing="0.1"
            android:text="@string/tilt_section_calibration"
            android:textAllCaps="true"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/calibrationState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="@string/tilt_state_none"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.35"
            android:text="@string/tilt_calibration_help"
            android:textColor="@color/muted"
            android:textSize="12.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/referenceMass"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:fontFamily="monospace"
                android:hint="@string/tilt_hint_mass"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:text="@string/tilt_default_mass"
                android:textColor="@color/ink"
                android:textColorHint="@color/muted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/calibrate"
                style="@style/BtnSolid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="@string/tilt_btn_calibrate" />
        </LinearLayout>

        <TextView
            android:id="@+id/forget"
            style="@style/Btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="@string/tilt_btn_forget"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
