<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/res_back"
                android:textColor="@color/muted"
                android:textSize="15sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/res_title"
                android:textAllCaps="true"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.14" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/res_intro"
            android:textColor="@color/muted"
            android:textSize="13.5sp"
            android:lineSpacingMultiplier="1.35" />

        <!-- odczyt -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="20dp">

            <TextView
                android:id="@+id/mass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/value_initial"
                android:textColor="@color/ink"
                android:textSize="64sp"
                android:fontFamily="monospace"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unit_g"
                android:textColor="@color/muted"
                android:textSize="16sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/frequency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/res_dash"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_chip"
            android:padding="14dp"
            android:text="@string/res_status_start"
            android:textColor="@color/ink"
            android:textSize="12.5sp"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.4" />

        <!-- kroki -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/res_step_1"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/stateEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/res_not_measured"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/stepEmpty"
            style="@style/BtnSolid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/res_btn_empty" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/res_step_2"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/stateCalibration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/res_not_calibrated"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <EditText
            android:id="@+id/referenceMass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:fontFamily="monospace"
            android:hint="@string/res_hint_mass"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:text="@string/res_default_mass"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/stepReference"
            style="@style/Btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/res_btn_reference" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/res_step_3"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/stepWeigh"
            style="@style/Btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="@string/res_btn_weigh" />
    </LinearLayout>
</ScrollView>
