<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:text="@string/sen_back"
                android:textColor="@color/muted"
                android:textSize="15sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:letterSpacing="0.14"
                android:text="@string/sen_title"
                android:textAllCaps="true"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingMultiplier="1.35"
            android:text="@string/sen_intro"
            android:textColor="@color/muted"
            android:textSize="13.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/mass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:text="@string/value_initial"
                android:textColor="@color/ink"
                android:textSize="60sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/unit_g"
                android:textColor="@color/muted"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/channelTilt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:text="@string/sen_tilt_none"
                android:textColor="@color/accent"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/channelResonance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:text="@string/sen_res_none"
                android:textColor="@color/accent"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/live"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:text="@string/sen_live_waiting"
                android:textColor="@color/ok"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/presence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:text="@string/sen_presence_no"
                android:textColor="@color/muted"
                android:textSize="12.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_chip"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.4"
            android:padding="14dp"
            android:text="@string/sen_status_start"
            android:textColor="@color/ink"
            android:textSize="12.5sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.1"
            android:text="@string/sen_step_1"
            android:textAllCaps="true"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stateZero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="@string/sen_not_measured"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tare"
            style="@style/Btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/sen_btn_tare" />

        <TextView
            android:id="@+id/stepZero"
            style="@style/BtnSolid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/sen_btn_zero" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.1"
            android:text="@string/sen_step_2"
            android:textAllCaps="true"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stateModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="@string/sen_no_references"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/referenceMass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:fontFamily="monospace"
            android:hint="@string/sen_hint_mass"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:text="@string/sen_default_mass"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/stepReference"
            style="@style/Btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/sen_btn_reference" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.1"
            android:text="@string/sen_step_3"
            android:textAllCaps="true"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stepWeigh"
            style="@style/Btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/sen_btn_weigh" />

        <TextView
            android:id="@+id/reset"
            style="@style/Btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="@string/sen_btn_reset" />
    </LinearLayout>
</ScrollView>
