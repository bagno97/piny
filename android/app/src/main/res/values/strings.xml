    <string name="res_recording_empty">Nie dotykaj telefonu… mierzę drgania własne.</string>
    <string name="res_recording_reference">Wzorzec na telefonie, ręce z dala… mierzę.</string>
    <string name="res_recording_object">Przedmiot na telefonie, ręce z dala… mierzę.</string>

    <string name="res_empty_done">Zmierzono drgania własne. Teraz połóż wzorzec i wykonaj krok 2.</string>
    <string name="res_reference_done">Skalibrowano. Masa układu %1$s g, rozdzielczość ok. %2$s g.</string>
    <string name="res_weigh_done">Zważono. To %1$s ct.</string>

    <string name="res_need_empty">Najpierw zmierz pusty telefon (krok 1).</string>
    <string name="res_need_mass">Podaj masę wzorca w gramach.</string>
    <string name="res_need_calibration">Najpierw wykonaj kroki 1 i 2.</string>
    <string name="res_bad_reference">Częstotliwość nie spadła — to przeczy fizyce. Sprawdź, czy telefon leży na miękkim podłożu i czy wzorzec naprawdę na nim spoczywa.</string>
    <string name="res_no_peak">Nie znalazłem wyraźnych drgań. Podłoże jest za twarde albo za miękkie — spróbuj złożonego ręcznika lub gąbki.</string>
    <string name="res_too_few_samples">Za mało próbek (%1$d). Akcelerometr nie nadążył — spróbuj ponownie.</string>
    <string name="res_no_accelerometer">Ten telefon nie udostępnia akcelerometru — metoda rezonansowa jest niedostępna.</string>
    <string name="res_open">Rezonans</string>
