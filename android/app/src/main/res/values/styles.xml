<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Label">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">10.5sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.11</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Btn">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingBottom">11dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="BtnSolid" parent="Btn">
        <item name="android:background">@drawable/bg_button_solid</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="SheetTitle">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SheetBody">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <style name="Eyebrow">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">10.5sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
